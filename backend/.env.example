# Database Settings
DATABASE_URL=sqlite:///./sih_anpr.db
# PostgreSQL Example: DATABASE_URL=postgresql://user:password@localhost:5432/anpr_db

# YOLOv8 Configuration
# Path to custom-trained license plate detection model (.pt file)
YOLO_MODEL_PATH=models/anpr_yolov8.pt

# Processing Options
USE_GPU=false
CONFIDENCE_THRESHOLD=0.5
